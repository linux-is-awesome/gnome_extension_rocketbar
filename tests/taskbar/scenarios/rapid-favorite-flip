#!/usr/bin/env bash
# Running pinned → unpin/pin/unpin with no settle, then kill (favorite-flag rerender).
set -euo pipefail
# shellcheck source=../lib/scenario
source "$(cd "$(dirname "$0")/.." && pwd)/lib/scenario"

favorites_backup
trap scenario_cleanup EXIT

echo "== rapid-favorite-flip ×$FIXTURE_COUNT: install =="
"$STEPS/install" "$FIXTURE_COUNT"
"$STEPS/quit" "$FIXTURE_COUNT" || true
"$STEPS/unpin" "$FIXTURE_COUNT" >/dev/null 2>&1 || true

scenario_pin_then_launch

echo "== rapid-favorite-flip: thrash pin state (no settle) =="
"$STEPS/unpin" "$FIXTURE_COUNT"
"$STEPS/pin" "$FIXTURE_COUNT"
"$STEPS/unpin" "$FIXTURE_COUNT"
"$STEPS/kill" "$FIXTURE_COUNT"

echo "== rapid-favorite-flip: watch taskbar =="
"$STEPS/settle" "$FIXTURE_COUNT" 5

echo "== rapid-favorite-flip: cleanup =="
"$STEPS/uninstall" "$FIXTURE_COUNT"
trap - EXIT
favorites_restore

echo "rapid-favorite-flip ×$FIXTURE_COUNT ok (check taskbar for lingering / duplicate icons)"
