#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=../lib/scenario
source "$(cd "$(dirname "$0")/.." && pwd)/lib/scenario"

favorites_backup
trap scenario_cleanup EXIT

echo "== kill-pinned ×$FIXTURE_COUNT: install =="
"$STEPS/install" "$FIXTURE_COUNT"
"$STEPS/quit" "$FIXTURE_COUNT" || true
"$STEPS/unpin" "$FIXTURE_COUNT" >/dev/null 2>&1 || true

echo "== kill-pinned: pin + launch =="
"$STEPS/pin" "$FIXTURE_COUNT"
"$STEPS/launch" "$FIXTURE_COUNT"
"$STEPS/settle" "$FIXTURE_COUNT" 1
scenario_expect_counts 1

echo "== kill-pinned: kill while still pinned =="
"$STEPS/kill" "$FIXTURE_COUNT"
"$STEPS/settle" "$FIXTURE_COUNT" 2

echo "== kill-pinned: cleanup =="
"$STEPS/uninstall" "$FIXTURE_COUNT"
trap - EXIT
favorites_restore

echo "kill-pinned ×$FIXTURE_COUNT ok"
