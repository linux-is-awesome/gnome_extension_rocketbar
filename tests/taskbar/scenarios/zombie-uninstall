#!/usr/bin/env bash
# Pinned+running → remove .desktop (id stays in favorite-apps) → kill.
set -euo pipefail
# shellcheck source=../lib/scenario
source "$(cd "$(dirname "$0")/.." && pwd)/lib/scenario"

favorites_backup
trap scenario_cleanup EXIT

echo "== zombie-uninstall ×$FIXTURE_COUNT: install =="
"$STEPS/install" "$FIXTURE_COUNT"
"$STEPS/quit" "$FIXTURE_COUNT" || true
"$STEPS/unpin" "$FIXTURE_COUNT" >/dev/null 2>&1 || true

scenario_pin_then_launch

echo "== zombie-uninstall: remove-desktop (keep pinned in gsettings, keep running) =="
"$STEPS/remove-desktop" "$FIXTURE_COUNT"
scenario_expect_still_running
"$STEPS/settle" "$FIXTURE_COUNT" 3
scenario_expect_still_running

echo "== zombie-uninstall: kill (no unpin) =="
"$STEPS/kill" "$FIXTURE_COUNT"

echo "== zombie-uninstall: watch taskbar =="
"$STEPS/settle" "$FIXTURE_COUNT" 5

echo "== zombie-uninstall: cleanup =="
"$STEPS/uninstall" "$FIXTURE_COUNT"
trap - EXIT
favorites_restore

echo "zombie-uninstall ×$FIXTURE_COUNT ok (check taskbar for lingering / duplicate icons)"
