#!/usr/bin/env bash
# Pinned+running → remove .desktop → restore .desktop while still running.
set -euo pipefail
# shellcheck source=../lib/scenario
source "$(cd "$(dirname "$0")/.." && pwd)/lib/scenario"

favorites_backup
trap scenario_cleanup EXIT

echo "== desktop-restore-running ×$FIXTURE_COUNT: install =="
"$STEPS/install" "$FIXTURE_COUNT"
"$STEPS/quit" "$FIXTURE_COUNT" || true
"$STEPS/unpin" "$FIXTURE_COUNT" >/dev/null 2>&1 || true

scenario_pin_then_launch

echo "== desktop-restore-running: remove-desktop =="
"$STEPS/remove-desktop" "$FIXTURE_COUNT"
scenario_expect_still_running
"$STEPS/settle" "$FIXTURE_COUNT" 2
scenario_expect_still_running

echo "== desktop-restore-running: restore-desktop (still running) =="
"$STEPS/restore-desktop" "$FIXTURE_COUNT"
"$STEPS/settle" "$FIXTURE_COUNT" 2
scenario_expect_counts 1
scenario_expect_still_running

echo "== desktop-restore-running: watch for duplicates =="
"$STEPS/settle" "$FIXTURE_COUNT" 3

echo "== desktop-restore-running: unpin + kill =="
"$STEPS/unpin" "$FIXTURE_COUNT"
"$STEPS/kill" "$FIXTURE_COUNT"
"$STEPS/settle" "$FIXTURE_COUNT" 2

echo "== desktop-restore-running: cleanup =="
"$STEPS/uninstall" "$FIXTURE_COUNT"
trap - EXIT
favorites_restore

echo "desktop-restore-running ×$FIXTURE_COUNT ok (check taskbar for lingering / duplicate icons)"
