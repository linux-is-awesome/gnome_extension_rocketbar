#!/usr/bin/env bash
# Install → see desktop → pin → run → unpin+kill with no settle (stale-button race).
set -euo pipefail
# shellcheck source=../lib/scenario
source "$(cd "$(dirname "$0")/.." && pwd)/lib/scenario"

favorites_backup
trap scenario_cleanup EXIT

echo "== rapid-unpin-kill ×$FIXTURE_COUNT: install =="
"$STEPS/install" "$FIXTURE_COUNT"
"$STEPS/quit" "$FIXTURE_COUNT" || true
"$STEPS/unpin" "$FIXTURE_COUNT" >/dev/null 2>&1 || true

scenario_pin_then_launch

echo "== rapid-unpin-kill: race unpin + kill (no settle between) =="
"$STEPS/unpin" "$FIXTURE_COUNT"
"$STEPS/kill" "$FIXTURE_COUNT"

echo "== rapid-unpin-kill: watch taskbar =="
"$STEPS/settle" "$FIXTURE_COUNT" 5

echo "== rapid-unpin-kill: cleanup =="
"$STEPS/uninstall" "$FIXTURE_COUNT"
trap - EXIT
favorites_restore

echo "rapid-unpin-kill ×$FIXTURE_COUNT ok (check taskbar for lingering / duplicate icons)"
