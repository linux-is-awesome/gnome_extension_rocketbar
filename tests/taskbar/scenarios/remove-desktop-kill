#!/usr/bin/env bash
# Pinned+running → remove .desktop → kill with no settle (installed-changed race).
set -euo pipefail
# shellcheck source=../lib/scenario
source "$(cd "$(dirname "$0")/.." && pwd)/lib/scenario"

favorites_backup
trap scenario_cleanup EXIT

echo "== remove-desktop-kill ×$FIXTURE_COUNT: install =="
"$STEPS/install" "$FIXTURE_COUNT"
"$STEPS/quit" "$FIXTURE_COUNT" || true
"$STEPS/unpin" "$FIXTURE_COUNT" >/dev/null 2>&1 || true

scenario_pin_then_launch

echo "== remove-desktop-kill: remove-desktop then kill (no settle) =="
"$STEPS/remove-desktop" "$FIXTURE_COUNT"
"$STEPS/kill" "$FIXTURE_COUNT"

echo "== remove-desktop-kill: watch taskbar =="
"$STEPS/settle" "$FIXTURE_COUNT" 5

echo "== remove-desktop-kill: cleanup =="
"$STEPS/uninstall" "$FIXTURE_COUNT"
trap - EXIT
favorites_restore

echo "remove-desktop-kill ×$FIXTURE_COUNT ok (check taskbar for lingering / duplicate icons)"
