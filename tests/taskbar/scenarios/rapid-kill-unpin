#!/usr/bin/env bash
# Pinned+running → kill → unpin with no settle (deferred destroy vs favorite flip).
set -euo pipefail
# shellcheck source=../lib/scenario
source "$(cd "$(dirname "$0")/.." && pwd)/lib/scenario"

favorites_backup
trap scenario_cleanup EXIT

echo "== rapid-kill-unpin ×$FIXTURE_COUNT: install =="
"$STEPS/install" "$FIXTURE_COUNT"
"$STEPS/quit" "$FIXTURE_COUNT" || true
"$STEPS/unpin" "$FIXTURE_COUNT" >/dev/null 2>&1 || true

scenario_pin_then_launch

echo "== rapid-kill-unpin: race kill + unpin (no settle between) =="
"$STEPS/kill" "$FIXTURE_COUNT"
"$STEPS/unpin" "$FIXTURE_COUNT"

echo "== rapid-kill-unpin: watch taskbar =="
"$STEPS/settle" "$FIXTURE_COUNT" 5

echo "== rapid-kill-unpin: cleanup =="
"$STEPS/uninstall" "$FIXTURE_COUNT"
trap - EXIT
favorites_restore

echo "rapid-kill-unpin ×$FIXTURE_COUNT ok (check taskbar for lingering / duplicate icons)"
