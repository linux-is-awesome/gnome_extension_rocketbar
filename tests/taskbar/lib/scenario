#!/usr/bin/env bash
# Shared scenario bootstrap: optional instance count (default 1).
# shellcheck source=./common
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common"

STEPS="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/steps"

if parse_fixture_count_arg "${1:-}"; then
    shift
fi
# Re-export so child steps inherit when not passed explicitly.
export FIXTURE_COUNT

scenario_cleanup() {
    favorites_restore
    "$STEPS/kill" "$FIXTURE_COUNT" >/dev/null 2>&1 || true
    "$STEPS/uninstall" "$FIXTURE_COUNT" >/dev/null 2>&1 || true
}

scenario_expect_counts() {
    local expected="$1"
    local got line
    got="$("$STEPS/window-count" "$FIXTURE_COUNT")"
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        if [[ "$line" != "$expected" ]]; then
            echo "expected window count $expected per instance, got:" >&2
            echo "$got" >&2
            return 1
        fi
    done <<< "$got"
}

scenario_expect_still_running() {
    local index
    for ((index = 1; index <= FIXTURE_COUNT; index++)); do
        set_fixture_instance "$index"
        if [[ -z "$(fixture_pids)" ]]; then
            echo "app already dead: $FIXTURE_INSTANCE_ID" >&2
            return 1
        fi
    done
}

# Requires install (+ wait_for_desktop). Pin while idle, then launch onto that favorite.
scenario_pin_then_launch() {
    echo "== pin (not running) =="
    "$STEPS/pin" "$FIXTURE_COUNT"
    "$STEPS/settle" "$FIXTURE_COUNT" 3
    echo "== launch onto pinned app =="
    "$STEPS/launch" "$FIXTURE_COUNT"
    "$STEPS/settle" "$FIXTURE_COUNT" 2
    scenario_expect_counts 1
}
