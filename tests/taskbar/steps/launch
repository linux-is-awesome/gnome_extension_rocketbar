#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=../lib/common
source "$(cd "$(dirname "$0")/.." && pwd)/lib/common"

if parse_fixture_count_arg "${1:-}"; then
    shift
fi

if [[ ! -x "$INSTALL_BIN" ]]; then
    echo "fixture not installed; run steps/install first" >&2
    exit 1
fi

_launch_one() {
    if bus_has_owner; then
        echo "already running: $FIXTURE_BUS_NAME"
        return 0
    fi
    if [[ ! -f "$DESKTOP_FILE" ]]; then
        echo "desktop missing for $FIXTURE_INSTANCE_ID; run steps/install" >&2
        return 1
    fi
    if command -v gtk-launch >/dev/null && gtk-launch "$FIXTURE_INSTANCE_ID"; then
        :
    else
        "$INSTALL_BIN" --app-id "$FIXTURE_INSTANCE_ID" &
        disown || true
    fi
    wait_for_bus_name 15
    echo "launched $FIXTURE_INSTANCE_ID"
}

fixture_foreach _launch_one
