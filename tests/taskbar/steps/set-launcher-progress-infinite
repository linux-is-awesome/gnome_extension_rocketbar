#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=../lib/common
source "$(cd "$(dirname "$0")/.." && pwd)/lib/common"

if parse_fixture_count_arg "${1:-}"; then
    shift
fi

visible="${1:-1}"

_set_one() {
    wait_for_bus_name 5
    case "$visible" in
        0 | false | no | off)
            fixture_call SetLauncherInfiniteProgress false >/dev/null
            ;;
        *)
            fixture_call SetLauncherInfiniteProgress true >/dev/null
            ;;
    esac
    echo "launcher infinite progress $FIXTURE_INSTANCE_ID: visible=$visible" >&2
}

fixture_foreach _set_one
