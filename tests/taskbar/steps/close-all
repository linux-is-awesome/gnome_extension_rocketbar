#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=../lib/common
source "$(cd "$(dirname "$0")/.." && pwd)/lib/common"

if parse_fixture_count_arg "${1:-}"; then
    shift
fi

_close_all_one() {
    wait_for_bus_name 5
    fixture_call CloseAll >/dev/null
    echo "closed all windows: $FIXTURE_INSTANCE_ID"
}

fixture_foreach _close_all_one
