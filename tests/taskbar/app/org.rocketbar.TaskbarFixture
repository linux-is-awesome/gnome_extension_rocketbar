#!/usr/bin/env python3
"""Controllable GTK4 fixture for Rocketbar taskbar service tests."""

import os
import sys

import gi

gi.require_version('Gtk', '4.0')
gi.require_version('Gio', '2.0')

from gi.repository import Gio, GLib, Gtk

DEFAULT_APP_ID = 'org.rocketbar.TaskbarFixture'
ICON_NAME = 'applications-utilities'
OBJECT_PATH = '/org/rocketbar/TaskbarFixture/Control'
IFACE = 'org.rocketbar.TaskbarFixture'

INTROSPECTION_XML = f'''
<node>
  <interface name="{IFACE}">
    <method name="OpenWindow">
      <arg type="u" name="window_id" direction="out"/>
    </method>
    <method name="CloseWindow">
      <arg type="u" name="window_id" direction="in"/>
      <arg type="b" name="ok" direction="out"/>
    </method>
    <method name="CloseAll"/>
    <method name="Quit"/>
    <method name="GetWindowCount">
      <arg type="u" name="count" direction="out"/>
    </method>
    <method name="ListWindows">
      <arg type="au" name="window_ids" direction="out"/>
    </method>
  </interface>
</node>
'''


def parse_app_id(argv):
    """Pull --app-id from argv; remaining args are for Gtk.Application.run."""
    app_id = os.environ.get('ROCKETBAR_FIXTURE_APP_ID', DEFAULT_APP_ID)
    out = [argv[0]]
    i = 1
    while i < len(argv):
        arg = argv[i]
        if arg == '--app-id' and i + 1 < len(argv):
            app_id = argv[i + 1]
            i += 2
            continue
        if arg.startswith('--app-id='):
            app_id = arg.split('=', 1)[1]
            i += 1
            continue
        out.append(arg)
        i += 1
    return app_id, out


class FixtureApp(Gtk.Application):

    def __init__(self, app_id):
        super().__init__(
            application_id=app_id,
            flags=Gio.ApplicationFlags.FLAGS_NONE
        )
        self._app_id = app_id
        self._windows = {}
        self._next_id = 1
        self._registration_id = 0
        self._connection = None
        self._iface_info = Gio.DBusNodeInfo.new_for_xml(INTROSPECTION_XML).interfaces[0]

    def do_startup(self):
        Gtk.Application.do_startup(self)
        Gtk.Window.set_default_icon_name(ICON_NAME)
        # Keep process alive with zero windows so CloseAll / recount still works.
        self.hold()

    def do_dbus_register(self, connection, object_path):
        self._connection = connection
        self._registration_id = connection.register_object(
            OBJECT_PATH,
            self._iface_info,
            self._handle_method,
            None,
            None
        )
        return Gtk.Application.do_dbus_register(self, connection, object_path)

    def do_dbus_unregister(self, connection, object_path):
        if self._registration_id:
            connection.unregister_object(self._registration_id)
            self._registration_id = 0
        Gtk.Application.do_dbus_unregister(self, connection, object_path)

    def do_activate(self):
        if not self._windows:
            self.open_window()

    def open_window(self):
        window_id = self._next_id
        self._next_id += 1
        window = Gtk.ApplicationWindow(application=self)
        window.set_title(f'Taskbar Fixture ({self._app_id}) #{window_id}')
        window.set_default_size(480, 320)
        label = Gtk.Label(
            label=f'Rocketbar taskbar fixture\n{self._app_id}\nwindow_id={window_id}'
        )
        label.set_margin_top(24)
        label.set_margin_bottom(24)
        label.set_margin_start(24)
        label.set_margin_end(24)
        window.set_child(label)
        window.connect('close-request', self._on_close_request, window_id)
        self._windows[window_id] = window
        window.present()
        return window_id

    def close_window(self, window_id):
        window = self._windows.pop(window_id, None)
        if window is None:
            return False
        window.destroy()
        return True

    def close_all(self):
        for window_id in list(self._windows):
            self.close_window(window_id)

    def _on_close_request(self, window, window_id):
        self._windows.pop(window_id, None)
        return False

    def _quit(self):
        self.release()
        self.quit()
        return False

    def _handle_method(self, connection, sender, object_path, interface_name,
                       method_name, parameters, invocation):
        try:
            if method_name == 'OpenWindow':
                window_id = self.open_window()
                invocation.return_value(GLib.Variant('(u)', (window_id,)))
            elif method_name == 'CloseWindow':
                window_id = parameters.unpack()[0]
                ok = self.close_window(window_id)
                invocation.return_value(GLib.Variant('(b)', (ok,)))
            elif method_name == 'CloseAll':
                self.close_all()
                invocation.return_value(None)
            elif method_name == 'Quit':
                self.close_all()
                invocation.return_value(None)
                GLib.idle_add(self._quit)
            elif method_name == 'GetWindowCount':
                invocation.return_value(GLib.Variant('(u)', (len(self._windows),)))
            elif method_name == 'ListWindows':
                ids = list(self._windows.keys())
                invocation.return_value(GLib.Variant('(au)', (ids,)))
            else:
                invocation.return_error_literal(
                    Gio.DBusError.quark(),
                    Gio.DBusError.UNKNOWN_METHOD,
                    f'Unknown method {method_name}'
                )
        except Exception as error:
            invocation.return_dbus_error(f'{IFACE}.Error', str(error))


def main():
    app_id, argv = parse_app_id(sys.argv)
    app = FixtureApp(app_id)
    return app.run(argv)


if __name__ == '__main__':
    sys.exit(main())
