msgid "Left"
msgstr "Слева"

#: preferences/ui/panel.ui:161
msgid "Center"
msgstr "По центру"

#: preferences/ui/panel.ui:162
msgid "Right"
msgstr "Справа"

#: preferences/ui/taskbar.ui:18
msgid "Isolate Workspaces"
msgstr "Изолировать рабочие столы"

#: preferences/ui/taskbar.ui:19
msgid "Show apps from the current workspace only"
msgstr "Показывать только приложения текущего рабочего стола"

#: preferences/ui/taskbar.ui:24
msgid "Include All Windows"
msgstr "Добавить все окна"

#: preferences/ui/taskbar.ui:25
msgid "Enable management of windows marked to skip the taskbar"
msgstr "Управлять окнами, помеченными для исключенния из панели задач"

#: preferences/ui/taskbar.ui:30
msgid "Show Pinned Apps"
msgstr "Показывать прикрепленные приложения"

#: preferences/ui/taskbar.ui:31
msgid "Always show pinned apps on the taskbar, even if they are not running"
msgstr "Всегда показывать прикрепленные приложения на панели задач, даже если они не запущены"

#: preferences/ui/taskbar.ui:37
msgid "Always Show Separator"
msgstr "Всегда показывать разделитель"

#: preferences/ui/taskbar.ui:38
msgid "Make the separator between pinned and running apps always visible"
msgstr "Всегда показывать разделитель между прикрепленными и запущенными приложениями"

#: preferences/ui/taskbar.ui:45
msgid "Multi-Monitor Window Routing"
msgstr "Маршрутизация окон на нескольких мониторах"

#: preferences/ui/taskbar.ui:46
msgid "Enable preferred monitor selection for each app and automatically route all newly opened windows there"
msgstr "Позволяет выбор предпочитаемого монитора для каждого приложения для автоматического перемещения новых окон на выбранный монитор"

#: preferences/ui/taskbar.ui:52
msgid "Handle Monitor Changes"
msgstr "Обрабатывать изменение мониторов"

#: preferences/ui/taskbar.ui:53
msgid "Automatically attempt to restore window positions after monitor changes"
msgstr "Автоматически восстанавливать позиции окон после изменения мониторов"

#: preferences/ui/taskbar.ui:66
msgid "Limit the taskbar length to a percentage of the monitor size"
msgstr "Ограничить длину панели задач в процентах от размера монитора"

#: preferences/ui/taskbar.ui:81
msgid "Apps"
msgstr "Приложения"

#: preferences/ui/taskbar.ui:84
msgid "Default Behavior"
msgstr "Поведение по умолчанию"

#: preferences/ui/taskbar.ui:137
msgid "Components"
msgstr "Компоненты"

#: preferences/ui/taskbar.ui:151
msgid "App Menus"
msgstr "Меню приложений"

#: preferences/ui/tweaks.ui:4
msgid "Tweaks"
msgstr "Твики"

#: preferences/ui/tweaks.ui:8
msgid "Overview"
msgstr "Режим обзора"

#: preferences/ui/tweaks.ui:11
msgid "Hide Search"
msgstr "Скрыть поиск"

#: preferences/ui/tweaks.ui:12
msgid "Hide the search input and increase size of the workspace thumbnails"
msgstr "Скрыть поле поиска и увеличить размер миниатюр рабочих столов"

#: preferences/ui/tweaks.ui:17
msgid "Hide Dash"
msgstr "Скрыть панель приложений"

#: preferences/ui/tweaks.ui:18
msgid "Hide the Dash and prevent it from rendering behind the scene. The Show Apps button will remain visible"
msgstr "Скрыть панель приложений и запретить ее отрисовку. Кнопка «Показать приложения» останется видимой"

#: preferences/ui/tweaks.ui:23
msgid "Hide Show Apps Button"
msgstr "Скрыть кнопку «Показать приложения»"

#: preferences/ui/tweaks.ui:24
msgid "Hide the Show Apps button in the Dash"
msgstr "Скрыть кнопку «Показать приложения» на панели приложений"

#: preferences/ui/tweaks.ui:29
msgid "Expand Workspace Background"
msgstr "Расширить фон рабочего стола"

#: preferences/ui/tweaks.ui:30
msgid "Expand the active workspace background to fill the space under the panel during Overview transitions. Enable to avoid visual glitches behind the transparent panel"
msgstr "Растягивать фон активного рабочего стола на область под панелью при переходах в режиме обзора. Включите, чтобы убрать артефакты за прозрачной панелью"

#: preferences/ui/tweaks.ui:35
msgid "Click Actions"
msgstr "Действия по клику"

#: preferences/ui/tweaks.ui:36
msgid "Left button click on an empty space hides the Overview, long press or right button click toggles the App Grid. Close windows using middle button (or left button while holding down the Ctrl key)"
msgstr "Клик левой кнопкой по пустому месту скрывает обзор, долгое нажатие или правая кнопка переключает меню приложений. Средняя кнопка для закрытия окон (или левая при удержании Ctrl)"

#: preferences/ui/tweaks.ui:41
msgid "Smooth Search Leave"
msgstr "Плавный выход из поиска"

#: preferences/ui/tweaks.ui:42
msgid "Return to the workspace view before closing the Overview when search is active. Avoids stutter when launching apps from search or dismissing the Overview while searching"
msgstr "Перед закрытием режима обзора при активном поиске возвращаться к виду рабочего стола. Уменьшает рывки при запуске приложений из поиска или при выходе из обзора во время поиска"

#: preferences/ui/tweaks.ui:49
msgid "Popups"
msgstr "Всплывающие окна"

#: preferences/ui/tweaks.ui:52
msgid "Remove Display Delay (LS)"
msgstr "Убрать задержку отображения (LS)"

#: preferences/ui/tweaks.ui:53
msgid "Instantly display all popups for better recognition"
msgstr "Мгновенно показывать все всплывающие окна для лучшего распознавания"

#: preferences/ui/tweaks.ui:58
msgid "Prevent Focus Stealing"
msgstr "Запретить перехват фокуса"

#: preferences/ui/tweaks.ui:59
msgid "Prevent window focus from being lost when switching windows or input languages"
msgstr "Предотвратить снятие фокуса с активного окна при переключении окон или раскладок клавиатуры"

#: preferences/ui/tweaks.ui:66
msgid "Menus"
msgstr "Меню"

#: preferences/ui/tweaks.ui:69
msgid "Click To Open (LS)"
msgstr "Открывать по клику (LS)"

#: preferences/ui/tweaks.ui:70
msgid "Require a click to open menus"
msgstr "Требовать клик для открытия меню"

#: preferences/ui/tweaks.ui:75
msgid "Auto-Align (LS)"
msgstr "Автовыравнивание (LS)"

#: preferences/ui/tweaks.ui:76
msgid "Automatically align menus based on their position on the screen. Enable if a non-standard panel position is used"
msgstr "Автоматически выравнивать меню по их положению на экране. Включите при нестандартном расположении панели"

#: preferences/ui/tweaks.ui:83
msgid "Input Sources"
msgstr "Источники ввода"

#: preferences/ui/tweaks.ui:86
msgid "Primary Language For Password Fields (LS)"
msgstr "Основной язык для полей пароля (LS)"

#: preferences/ui/tweaks.ui:87
msgid "Automatically switch to the primary input language when any password field becomes active"
msgstr "Автоматически переключаться на основную раскладку при активации поля пароля"

#: preferences/ui/tweaks.ui:92
msgid "Uppercase Indicator (LS)"
msgstr "Индикатор в верхнем регистре (LS)"

#: preferences/ui/tweaks.ui:93
msgid "Display input languages in uppercase (en → EN)"
msgstr "Отображать языки ввода в верхнем регистре (ru → RU)"

#: preferences/ui/tweaks.ui:103
msgid "Always Show System Notifications"
msgstr "Всегда показывать системные уведомления"

#: preferences/ui/tweaks.ui:104
msgid "Allow system notifications to bypass Do Not Disturb mode"
msgstr "Разрешить системным уведомлениям обходить режим «Не беспокоить»"

#: preferences/ui/tweaks.ui:112
msgid "Requires Lockscreen session mode for the extension to be enabled"
msgstr "Режим работы расширения «Экран разблокировки» должен быть включен"

#: preferences/ui/tweaks.ui:115
msgid "Restore Unlock Animation"
msgstr "Восстановить анимацию разблокировки"

#: preferences/ui/tweaks.ui:116
msgid "Bring back the unlock slide-up animation"
msgstr "Возвращает анимацию при разблокировке экрана"

